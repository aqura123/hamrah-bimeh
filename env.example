# ==============================================================================
# Hamrah Bimeh (همراه بیمه) — Environment Configuration Template
# Copy to `.env` and set secure values before running. Never commit `.env`.
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Connection
# Production: PostgreSQL connection URI, e.g. postgresql://user:password@db-host:5432/hamrah_bimeh
# Local dev without external Postgres daemon: pglite://./storage/pgdata
DATABASE_URL=pglite://./storage/pgdata

# Session & Security Secrets (REQUIRED in production: min 32 random characters)
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS_IN_PRODUCTION
# 32 random bytes in hex; keep separately from the database and backups.
CARD_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Independent 32-byte key for external portal credentials; never share with the card key.
PORTAL_CREDENTIAL_KEY=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
SESSION_TTL_HOURS=12
# Set true ONLY inside cross-origin preview sandboxes; MUST be false in production on your own domain
PREVIEW_IFRAME_COMPAT=false
# Optional frame-ancestors policy when PREVIEW_IFRAME_COMPAT=false (default: 'none')
FRAME_ANCESTORS='none'

# Business & Localization Settings
BUSINESS_TIMEZONE=Asia/Tehran
# Single currency convention across DB storage and UI display: TOMAN or RIAL (never mixed)
CURRENCY_UNIT=TOMAN
# Customer onboarding initial password mode:
#   national_id — uses customer's validated National ID hashed with Argon2id + mandatory password change on first login
#   generated   — generates a random one-time temporary password + mandatory password change on first login
INITIAL_PASSWORD_MODE=national_id
# Hours after which an active request surfaces as an incomplete-request alert for office staff
INCOMPLETE_ALERT_HOURS=72

# Private File Storage Settings
PRIVATE_STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_MIMES=application/pdf,image/jpeg,image/png,image/webp
# Antivirus integration mode: disabled | clamav_command (honest reporting; do not set unless configured)
ANTIVIRUS_MODE=disabled

# Bootstrap Office Admin (Used ONLY by `npm run db:bootstrap-admin` or dev seed; never use weak credentials in prod)
BOOTSTRAP_ADMIN_MOBILE=09120000000
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=مدیر دفتر همراه بیمه

# Configurable Public Office Contact Placeholders (Set by office before launch; left empty to render clear placeholders)
PUBLIC_OFFICE_TITLE=دفتر خدمات بیمه‌ای همراه بیمه
PUBLIC_OFFICE_ADDRESS=
PUBLIC_OFFICE_PHONE=
PUBLIC_OFFICE_WORKING_HOURS=
PUBLIC_OFFICE_MAP_NOTE=
